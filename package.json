{
  "name": "copilot-model-fallback",
  "displayName": "GCMP Companion: Model Fallback Chains",
  "description": "GCMP companion extension: composite language models with automatic cross-provider fallback for Copilot Chat, delegating model calls to GCMP-registered vendors.",
  "version": "0.1.0",
  "publisher": "tacrine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tacrine/copilot-model-fallback.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "extensionDependencies": [
    "vicanent.gcmp"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "fallback",
    "language-model",
    "router",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguageModelChatProvider:fallbackrouter"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "fallbackrouter",
        "displayName": "Fallback Router",
        "managementCommand": "fallbackrouter.manage"
      },
      {
        "vendor": "spike-test",
        "displayName": "Spike Echo (test)"
      }
    ],
    "commands": [
      {
        "command": "fallbackrouter.manage",
        "title": "Fallback Router: Manage"
      },
      {
        "command": "fallbackrouter.apply",
        "title": "Fallback Router: Apply imported chains"
      },
      {
        "command": "fallbackrouter.warmup",
        "title": "Fallback Router: Warm up proxy targets"
      },
      {
        "command": "fallbackrouter.set-default-model",
        "title": "Fallback Router: Set default model"
      },
      {
        "command": "fallbackrouter.showDiagnostics",
        "title": "Fallback Router: Show diagnostics"
      },
      {
        "command": "fallbackrouter.cleanup",
        "title": "Fallback Router: Clean up stored data"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "fallbackRouter.chains": {
          "type": "array",
          "default": [],
          "markdownDescription": "%configuration.properties.fallbackRouter.chains.markdownDescription%"
        },
        "fallbackRouter.retry": {
          "type": "object",
          "default": {
            "maxAttempts": 3,
            "initialDelayMs": 1000,
            "backoffFactor": 2,
            "maxDelayMs": 15000
          },
          "markdownDescription": "%configuration.properties.fallbackRouter.retry.markdownDescription%"
        },
        "fallbackRouter.circuitBreaker": {
          "type": "object",
          "default": {
            "failureThreshold": 3,
            "cooldownMs": 60000
          },
          "markdownDescription": "%configuration.properties.fallbackRouter.circuitBreaker.markdownDescription%"
        },
        "fallbackRouter.maxTurnMs": {
          "type": "number",
          "default": 600000,
          "markdownDescription": "%configuration.properties.fallbackRouter.maxTurnMs.markdownDescription%"
        },
        "fallbackRouter.maxTargetsPerTurn": {
          "type": "number",
          "default": 5,
          "markdownDescription": "%configuration.properties.fallbackRouter.maxTargetsPerTurn.markdownDescription%"
        },
        "fallbackRouter.importMode": {
          "type": "string",
          "enum": [
            "family",
            "exact"
          ],
          "default": "family",
          "markdownDescription": "%configuration.properties.fallbackRouter.importMode.markdownDescription%"
        },
        "fallbackRouter.retryOnRateLimit": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.properties.fallbackRouter.retryOnRateLimit.markdownDescription%"
        },
        "fallbackRouter.noticeStyle": {
          "type": "string",
          "enum": [
            "markdown",
            "plain"
          ],
          "default": "markdown",
          "markdownDescription": "%configuration.properties.fallbackRouter.noticeStyle.markdownDescription%"
        },
        "fallbackRouter.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "markdownDescription": "%configuration.properties.fallbackRouter.logLevel.markdownDescription%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node esbuild.js && node esbuild.js --spike && node scripts/run-spike.js",
    "qa:faults": "node esbuild.js --qa && node test/qa/faults.bundle.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
